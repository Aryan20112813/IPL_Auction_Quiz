# Database Connection (SQLite for zero-config local run, or PostgreSQL for production)
DATABASE_URL="file:./dev.db"
# Example PostgreSQL:
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ipl_quiz?schema=public"

# Base URL for QR codes and host recovery links
APP_URL="http://localhost:3000"

# Secret pepper for token hashing
TOKEN_PEPPER="ipl-auction-quiz-secret-salt-2025"

# Quiz configuration limits
MAX_PARTICIPANTS=500
QUIZ_DURATION_SECONDS=7200
QUESTION_COUNT=25
