# ─────────────────────────────────────────────────────────
# LOCAL DEVELOPMENT (SQLite — zero-config, no Postgres needed)
# ─────────────────────────────────────────────────────────
# DATABASE_URL="file:./dev.db"
# DATABASE_URL_UNPOOLED="file:./dev.db"

# ─────────────────────────────────────────────────────────
# PRODUCTION (PostgreSQL — required for Vercel / Railway / VPS)
# ─────────────────────────────────────────────────────────
# Vercel Postgres  → Connection Pooling URL (used at runtime)
# Neon             → postgresql://user:pass@ep-xxx.us-east-1.neon.tech/neondb?sslmode=require
# Supabase         → postgresql://user:pass@db.xxx.supabase.co:5432/postgres
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require"

# Direct URL — bypasses PgBouncer for migrations (Neon / Vercel Postgres only)
# Same as DATABASE_URL if you're NOT using connection pooling (Railway, self-hosted)
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require"

# ─────────────────────────────────────────────────────────
# REQUIRED in all environments
# ─────────────────────────────────────────────────────────

# Public URL of the app (used in QR code links)
APP_URL="http://localhost:3000"

# Secret pepper for token hashing — generate with:
#   node -e "console.log(require('crypto').randomBytes(36).toString('base64url'))"
TOKEN_PEPPER="replace-with-48-char-random-secret"

# ─────────────────────────────────────────────────────────
# OPTIONAL — override defaults
# ─────────────────────────────────────────────────────────
MAX_PARTICIPANTS=500
QUIZ_DURATION_SECONDS=7200
QUESTION_COUNT=25
LOG_LEVEL=info
